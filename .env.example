DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/champs_school?schema=public"
JWT_SECRET="replace-with-at-least-32-random-characters"

# Private S3/R2-compatible object storage for payment proofs.
S3_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="champs-school-payment-proofs"
S3_ACCESS_KEY_ID="replace-me"
S3_SECRET_ACCESS_KEY="replace-me"
S3_FORCE_PATH_STYLE="true"
S3_SERVER_SIDE_ENCRYPTION="AES256"

# Development-only escape hatch. Never enable this in production.
LOCAL_UPLOAD_STORAGE="false"
